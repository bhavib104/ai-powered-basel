# ---------------------------------------------------------------------------
# Example environment configuration for the backend.
# Copy this file to `.env` and adjust as needed.  NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text
API_V1_PREFIX=/api/v1

# --- Database ---
# Local, file-based SQLite by default.  Swap to PostgreSQL later by changing
# this single value, e.g. postgresql+psycopg://user:pass@localhost:5432/basel
DATABASE_URL=sqlite:///./data/basel.db

# --- CORS (frontend dev server origins) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- AI / LLM ---
# llm_provider: ollama | openai | mock
# `mock` returns deterministic canned responses and requires no credentials,
# which keeps tests and offline development working.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (local, no API key required) ---
# backend: auto | sentence-transformers | hashing
#   auto   -> try the real model, fall back to deterministic hashing offline
#   hashing-> dependency-free deterministic vectors (used by tests/CI)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25

# --- AI tool limits (safety bounds) ---
AI_MAX_TOOL_CALLS=8
AI_TOOL_TIMEOUT_SECONDS=20
